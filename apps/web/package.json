{
  "name": "@object-memory/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config playwright.config.ts",
    "pretest:e2e:real": "npm run build",
    "test:e2e:real": "playwright test --config playwright.config.ts",
    "pretest:e2e:voice": "npm run build",
    "test:e2e:voice": "playwright test --config playwright.voice.config.ts",
    "pretest:e2e:demo": "npm run build",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "pretest:e2e:mock-contract": "npm run build",
    "test:e2e:mock-contract": "playwright test --config playwright.mock.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "0.468.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.185.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
