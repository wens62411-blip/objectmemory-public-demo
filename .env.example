# Port is selected by start.ps1 -Port (default 8018).
# Relative to project root, supports Unicode and spaces.
OM_DATA_DIR=data
# Fail-closed mode. Start.bat overrides this with REAL and the no-hardware
# launcher overrides it with DEMO. TEST is reserved for automation.
OM_RUNTIME_MODE=REAL
# Localhost is the default. Set to 1 only when intentionally enabling LAN
# access; LAN clients still require the generated administrator access code.
OM_ALLOW_LAN=0
# Local appearance model CPU threads: optional integer 1..4. Unset/invalid
# uses the logical CPU count capped at 4; configure before starting the service.
# OM_APPEARANCE_THREADS=4
MAX_STORAGE_MB=500
# Local browser receives a local session automatically. LAN browser uses generated local PIN.
